{
  "name": "to-markdown",
  "version": "1.2.0",
  "private": true,
  "description": "Konverter dokumen ke Markdown dengan pemrosesan di memori.",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "desktop": "electron .",
    "dist": "electron-builder --win --x64"
  },
  "dependencies": {
    "@fontsource-variable/league-spartan": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@highlightjs/cdn-assets": "^11.12.0",
    "csv-parse": "^7.0.3",
    "dompurify": "^3.4.18",
    "exceljs": "^4.4.0",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "katex": "^0.19.1",
    "mammoth": "^1.13.0",
    "marked": "^18.2.0",
    "mermaid": "^12.3.0",
    "multer": "^2.5.0",
    "pdfjs-dist": "^6.5.438",
    "sanitize-html": "^2.18.2",
    "turndown": "^7.2.5",
    "turndown-plugin-gfm": "^1.0.2",
    "yauzl": "^3.4.0"
  },
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    }
  },
  "devDependencies": {
    "electron": "^45.3.3",
    "electron-builder": "^26.18.0",
    "jszip": "^3.10.2",
    "supertest": "^7.3.2"
  },
  "main": "desktop/main.cjs",
  "author": "To Markdown"
}
